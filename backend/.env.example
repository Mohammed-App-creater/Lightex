# Copy to .env for local development. Never commit real values.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lightex

# Web client origin(s): CORS with credentials, refresh-cookie Origin check, email links.
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Refresh-token cookie. Use SameSite=None (and Secure) when the client and API are on different sites.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=Lax
# REFRESH_COOKIE_DOMAIN=

# Optional. Without REDIS_URL, Celery tasks run inline (no worker needed) and the cache is in-process.
REDIS_URL=
# CELERY_TASK_ALWAYS_EAGER=true

# Email. Console backend prints emails to stdout in development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Lightex <no-reply@lightex.local>
# EMAIL_HOST= EMAIL_PORT=587 EMAIL_HOST_USER= EMAIL_HOST_PASSWORD= EMAIL_USE_TLS=true
COMPANY_ADDRESS=Lightex

# Attachments: "r2" (Cloudflare R2, production), "local" (files on disk behind signed URLs
# served by this API; development) or "fake" (in memory; tests).
STORAGE_BACKEND=local
API_PUBLIC_URL=http://localhost:8000
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=

# JWT lifetimes
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14
