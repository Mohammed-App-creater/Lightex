# Copy to .env for local development. Never commit real values.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lightex
# Neon: paste the connection string from the Neon console (Connect → Django), keep ?sslmode=require.
# Using the pooled host (…-pooler.…neon.tech)? Set DB_POOLED=true and DB_CONN_MAX_AGE=0.
# DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# DB_POOLED=true
# DB_CONN_MAX_AGE=0

# Web client origin(s): CORS with credentials, refresh-cookie Origin check, email links.
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Refresh-token cookie. Use SameSite=None (and Secure) when the client and API are on different sites.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=Lax
# REFRESH_COOKIE_DOMAIN=

# Optional. Without REDIS_URL, Celery tasks run inline (no worker needed) and the cache is in-process.
REDIS_URL=
# CELERY_TASK_ALWAYS_EAGER=true

# Email. Console backend prints emails to stdout in development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Lightex <no-reply@lightex.local>
# EMAIL_HOST= EMAIL_PORT=587 EMAIL_HOST_USER= EMAIL_HOST_PASSWORD= EMAIL_USE_TLS=true
COMPANY_ADDRESS=Lightex

# Attachments: "r2" (Cloudflare R2, production), "local" (files on disk behind signed URLs
# served by this API; development) or "fake" (in memory; tests).
STORAGE_BACKEND=local
API_PUBLIC_URL=http://localhost:8000
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# S3 API endpoint, not the public r2.dev URL. Defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=

# JWT lifetimes
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14

# Sign in with Google (Google Cloud console -> Credentials -> OAuth client 'Web application').
# Authorised redirect URI: <API_PUBLIC_URL>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
