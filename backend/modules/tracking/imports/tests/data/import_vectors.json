  },
  {
   "name": "header only uses the header count",
   "text": "a;b;c,d\n",
   "delimiter": ";"
  }
 ],
 "parse": [
  {
   "name": "quotes, doubled quotes, CRLF",
   "text": "Title,Description\r\n\"Rate-limit, reset\",\"Spec in \"\"Billing v2\"\" doc\"\r\n",
   "delimiter": ",",
   "header": [
    "Title",
    "Description"
   ],
   "rows": [
    [
     "Rate-limit, reset",
     "Spec in \"Billing v2\" doc"
    ]
   ]
  },
  {
   "name": "embedded newline inside quotes",
   "text": "Title,Notes\nA,\"line 1\nline 2\"\nB,x\n",
   "delimiter": ",",
   "header": [
    "Title",
    "Notes"
   ],
   "rows": [
    [
     "A",
     "line 1\nline 2"
    ],
    [
     "B",
     "x"
    ]
   ]
  },
  {
   "name": "embedded CRLF inside quotes becomes LF (CR is a C0 control character)",
   "text": "Title,Notes\r\nA,\"line 1\r\nline 2\"\r\n",
   "delimiter": ",",
   "header": [
    "Title",
    "Notes"
   ],
   "rows": [
    [
     "A",
     "line 1\nline 2"
    ]
   ]
  },
  {
   "name": "empty lines are ignored, short rows padded, long rows cut",
   "text": "A,B,C\n\n1\n1,2,3,4\n",
   "delimiter": ",",
   "header": [
    "A",
    "B",
    "C"
   ],
   "rows": [
    [
     "1",
     "",
     ""
    ],
    [
     "1",
     "2",
     "3"
    ]
   ]
  },
  {
   "name": "no trailing newline",
   "text": "A,B\n1,2",
   "delimiter": ",",
   "header": [
    "A",
    "B"
   ],
   "rows": [
    [
     "1",
     "2"
    ]
   ]
  },
  {
   "name": "blank and duplicate headers",
   "text": "Labels,,Labels,labels\nx,y,z,w\n",
   "delimiter": ",",
   "header": [
    "Labels",
    "Column 2",
    "Labels (2)",
    "labels (3)"
   ],
   "rows": [
    [
     "x",
     "y",
     "z",
     "w"
    ]
   ]
  },
  {
   "name": "control characters stripped (tab and newline kept)",
   "text": "Title\n\"A\u0007B\tC\"\n",
   "delimiter": ",",
   "header": [
    "Title"
   ],
   "rows": [
    [
     "AB\tC"
    ]
   ]
  },
  {
   "name": "unclosed quote reports the line it opened on",
   "text": "Title,Notes\nA,ok\nB,\"never closed\nC,x\n",
   "delimiter": ",",
   "error": {
    "reason": "unclosed_quote",
    "line": 3
   }
  },
