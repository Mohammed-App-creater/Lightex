# Copy to .env.local and adjust. Everything here is public (NEXT_PUBLIC_*): never put secrets in it.

# "mock" runs the whole app against an in-browser API with seeded data.
# "live" talks to the real backend at NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_API_MODE=mock

# Live mode only. Base URL of the backend; the client appends /api/v1.
# The backend must allow this app's origin with credentials (refresh-token cookie).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Live mode only. Origins of signed upload/download URLs (object storage), comma or space
# separated; added to the CSP connect-src and img-src. Leave empty when the backend uses
# STORAGE_BACKEND=local (it serves files itself). For Cloudflare R2 list both URL styles:
# https://<account>.r2.cloudflarestorage.com,https://<bucket>.<account>.r2.cloudflarestorage.com
NEXT_PUBLIC_UPLOAD_ORIGIN=

# Mock mode only. Probability (0..1) that a mock request fails with a server error.
# Default 0.03. Set 0 for demos and tests.
NEXT_PUBLIC_MOCK_ERROR_RATE=0.03

# Mock mode only. Simulated latency range in ms.
NEXT_PUBLIC_MOCK_LATENCY_MIN=100
NEXT_PUBLIC_MOCK_LATENCY_MAX=400

# Shows the dev role switcher and /dev/ui. Defaults to on outside production builds.
NEXT_PUBLIC_DEV_TOOLS=true

# Public origin of this app (used for absolute Open Graph / icon URLs).
NEXT_PUBLIC_APP_URL=http://localhost:3000
